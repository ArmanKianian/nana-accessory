---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import data from '../data/products.json';
const products = Array.isArray(data.products) ? data.products : [];
const updated = data.updated_at ? new Date(data.updated_at).toLocaleDateString('fa-IR') : '';
const description = 'خرید آنلاین اکسسوری دخترانه و فانتزی از نانا اکسسوری شاپ؛ دیدن مدل‌ها و قیمت‌های به‌روز، اکسسوری مو، گیره، کلیپس و هدیه‌های خاص. سفارش مستقیم از غرفه نانا در باسلام.';
const jsonLd = { '@context':'https://schema.org', '@type':'Store', name:'نانا اکسسوری شاپ', alternateName:'Nana Accessory Shop', url:'https://nana-accessory.ir/', description, image:'https://nana-accessory.ir/og-cover.svg', sameAs:['https://basalam.com/nana-accessory','https://www.instagram.com/nana.accessoryy/'], priceRange:'تومان' };
const productListSchema = { '@context':'https://schema.org', '@type':'ItemList', name:'محصولات نانا اکسسوری شاپ', itemListElement: products.map((product, index) => ({ '@type':'ListItem', position:index + 1, url:`https://nana-accessory.ir/products/${product.id}/`, name:product.name })) };
---
<BaseLayout description={description}>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(jsonLd)} /><script type="application/ld+json" set:html={JSON.stringify(productListSchema)} /></Fragment>
  <Header />
  <main>
    <section class="pink-gradient relative overflow-hidden">
      <div class="container grid min-h-[590px] items-center gap-10 py-16 md:grid-cols-[1.1fr_.9fr] md:py-20">
        <div class="relative z-10">
          <span class="mb-6 inline-flex items-center gap-2 rounded-full border border-rose-200 bg-white/70 px-4 py-2 text-xs font-bold text-[#a65d79]"><span>✿</span> یه گوشه‌ی کوچیک برای خوشگلی‌های تو</span>
          <h1 class="max-w-2xl text-4xl leading-[1.55] font-black tracking-tight text-[#593544] md:text-6xl">جزئیات کوچیک،<br/><span class="text-[#c46e91]">حالِ خوبِ بزرگ.</span></h1>
          <p class="mt-6 max-w-xl text-base leading-9 text-[#876b76] md:text-lg">به دنیای نانا خوش اومدی! اینجا اکسسوری‌های دخترونه، فانتزی و دوست‌داشتنی رو کنار هم می‌بینی؛ برای اینکه استایل هر روزت یه کوچولو بیشتر شبیه خودت باشه. ♡</p>
          <div class="mt-9 flex flex-wrap gap-3"><a href="#products" class="button-primary rounded-full px-7 py-4 text-sm font-extrabold shadow-xl shadow-rose-900/15 transition hover:-translate-y-1">دیدن محصولات نانا ↓</a><a href="https://www.instagram.com/nana.accessoryy/" target="_blank" rel="noopener noreferrer" class="rounded-full border border-[#d9a6b8] bg-white/60 px-7 py-4 text-sm font-bold text-[#74495b] transition hover:bg-white">گپ توی اینستاگرام ↗</a></div>
          <div class="mt-10 flex flex-wrap gap-6 text-xs font-bold text-[#a27b89]"><span>♡ انتخاب‌های دوست‌داشتنی</span><span>✿ مدل‌های فانتزی</span><span>✧ حال خوبِ نانا</span></div>
        </div>
        <div class="relative mx-auto w-full max-w-[470px]">
          <div class="absolute -inset-5 rotate-3 rounded-[3rem] bg-white/60"></div>
          <div class="absolute -right-5 top-10 z-20 grid size-16 rotate-12 place-items-center rounded-2xl border-4 border-white bg-[#f7d7e3] text-3xl text-[#a64f72] shadow-lg">♡</div>
          <div class="absolute -bottom-7 right-8 z-20 rounded-full border-4 border-white bg-[#fff0c9] px-5 py-3 text-sm font-black text-[#95643f] shadow-lg">tiny things, big joy ✿</div>
          <div class="relative grid aspect-[4/4.3] place-items-center overflow-hidden rounded-[2.7rem] border-[10px] border-white/80 bg-gradient-to-br from-[#f5cbd9] via-[#fce9e7] to-[#e8d9f2] soft-shadow">
            <div class="absolute left-8 top-8 text-5xl text-white/90">✿</div><div class="absolute right-8 bottom-8 text-5xl text-white/90">♡</div>
            <div class="text-center"><div class="mb-3 text-8xl text-[#b65e80]">୨୧</div><p class="text-3xl font-black text-[#74465a]">a little<br/>pretty things</p><p class="mt-4 text-sm font-bold tracking-widest text-[#a66d83]">NANA ACCESSORY</p></div>
          </div>
          <div class="absolute -bottom-5 -left-4 rounded-2xl bg-white px-5 py-3 text-sm font-black text-[#9d5875] soft-shadow">با عشق، برای تو ♡</div>
        </div>
      </div>
      <span class="ornament absolute right-[5%] top-12 text-5xl">✧</span><span class="ornament absolute bottom-12 left-[8%] text-4xl">♡</span><span class="absolute bottom-8 right-[48%] text-3xl text-[#e5a9bd]">୨୧</span>
    </section>

    <section id="products" class="container scroll-mt-24 py-20">
      <div class="mb-9 flex flex-wrap items-end justify-between gap-4"><div><p class="mb-3 text-sm font-black text-[#c16c8d]">✿ منتخب‌های نانا</p><h2 class="text-3xl font-black text-[#593544] md:text-4xl">یه چیز کوچولو، یه عالمه ذوق.</h2><p class="mt-3 text-sm leading-7 text-[#987d87]">محصولات و قیمت‌ها با غرفه‌ی نانا در باسلام هماهنگ می‌شن.</p></div><a href="https://basalam.com/nana-accessory" target="_blank" rel="noopener noreferrer" class="rounded-full border border-rose-200 px-5 py-3 text-xs font-bold text-[#9e5975] hover:bg-rose-50">مشاهده غرفه در باسلام ↗</a></div>
      {products.length > 0 ? <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-6">
        {products.map((product) => <article class="product-card overflow-hidden rounded-[1.6rem] border border-rose-100 bg-white p-2.5">
          <a href={`/products/${product.id}/`} aria-label={`مشاهده ${product.name} در فروشگاه نانا`}><img class="product-image w-full rounded-[1.2rem]" src={product.image || '/product-placeholder.svg'} alt={product.name} loading="lazy" decoding="async"/><div class="px-2 pt-4 pb-2"><h3 class="line-clamp-2 min-h-12 text-sm leading-6 font-extrabold text-[#62414f]">{product.name}</h3><div class="mt-3 flex items-center justify-between gap-2"><span class="text-sm font-black text-[#b65e80]">{product.price ? `${Number(product.price).toLocaleString('fa-IR')} تومان` : 'قیمت در باسلام'}</span><span class="text-xs text-[#c58aa0]">♡ جزئیات</span></div></div></a>
        </article>)}
      </div> : <div class="rounded-[2rem] border border-dashed border-rose-200 bg-[#fff7f8] px-6 py-14 text-center"><div class="text-5xl text-[#d78ca8]">୨୧</div><h3 class="mt-5 text-xl font-black text-[#70495a]">قشنگیا دارن آماده می‌شن!</h3><p class="mt-3 text-sm leading-7 text-[#987d87]">برای دیدن همه‌ی محصولات و قیمت‌های به‌روز، فعلاً به غرفه‌ی نانا در باسلام سر بزن.</p><a href="https://basalam.com/nana-accessory" target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex rounded-full bg-[#60394b] px-6 py-3 text-sm font-bold text-white">رفتن به غرفه نانا ↗</a></div>}
      <p class="mt-6 text-center text-[11px] text-[#b296a0]">{updated ? `آخرین به‌روزرسانی محصولات: ${updated}` : 'قیمت و موجودی نهایی را هنگام ثبت سفارش در باسلام بررسی کنید.'}</p>
    </section>

    <section id="about" class="bg-[#fff1f4] py-20"><div class="container grid items-center gap-10 md:grid-cols-2"><div><p class="text-sm font-black text-[#bd6d8c]">♡ یه یادداشت از نانا</p><h2 class="mt-4 text-3xl leading-[1.7] font-black text-[#593544]">گاهی یه جزئیات کوچولو می‌تونه کل روزت رو قشنگ‌تر کنه.</h2><p class="mt-5 text-sm leading-9 text-[#876b76]">نانا اکسسوری شاپ برای همون جزئیات دوست‌داشتنیه؛ اکسسوری‌ای که با ذوق انتخابش می‌کنی، چیزی که استایل ساده‌ت رو خاص‌تر می‌کنه و هدیه‌ی کوچولویی که لبخند میاره روی لبت. خوشحالیم که اینجایی! ♡</p><a href="https://www.instagram.com/nana.accessoryy/" target="_blank" rel="noopener noreferrer" class="mt-7 inline-flex rounded-full bg-white px-6 py-3 text-sm font-bold text-[#9e5975] shadow-sm">بیا گپ بزنیم ↗</a></div><div class="rounded-[2rem] border border-white bg-white/70 p-8 text-center soft-shadow"><div class="text-7xl text-[#d88eaa]">♡ ✿ ♡</div><p class="mt-5 text-2xl font-black text-[#75495b]">یه کوچولو خوشگلی،<br/>یه عالمه حس خوب.</p><p class="mt-4 text-sm text-[#a27b89]">NANA ACCESSORY SHOP</p></div></div></section>

    <section id="faq" class="container scroll-mt-24 py-20"><div class="mx-auto max-w-3xl"><p class="text-center text-sm font-black text-[#bd6d8c]">چندتا جواب کوچولو</p><h2 class="mt-3 mb-9 text-center text-3xl font-black text-[#593544]">سوال داری؟ ♡</h2><div class="space-y-3">
      <details class="group rounded-2xl border border-rose-100 bg-white p-5"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-extrabold text-[#694757]">چطوری سفارش بدم؟<span class="text-xl text-[#c16c8d] group-open:rotate-45">＋</span></summary><p class="mt-4 text-sm leading-8 text-[#927783]">روی محصول موردعلاقه‌ات بزن تا وارد صفحه‌ی همون محصول در باسلام بشی و سفارشت رو ثبت کنی. برای راهنمایی بیشتر هم می‌تونی توی اینستاگرام دایرکت بدی.</p></details>
      <details class="group rounded-2xl border border-rose-100 bg-white p-5"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-extrabold text-[#694757]">قیمت و موجودی محصولات به‌روزه؟<span class="text-xl text-[#c16c8d] group-open:rotate-45">＋</span></summary><p class="mt-4 text-sm leading-8 text-[#927783]">فهرست محصولات و قیمت‌ها به‌صورت خودکار از غرفه‌ی باسلام به‌روزرسانی می‌شه؛ بااین‌حال قیمت و موجودی نهایی رو در صفحه‌ی محصول باسلام بررسی کن.</p></details>
      <details class="group rounded-2xl border border-rose-100 bg-white p-5"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-extrabold text-[#694757]">مدل‌های جدید رو از کجا ببینم؟<span class="text-xl text-[#c16c8d] group-open:rotate-45">＋</span></summary><p class="mt-4 text-sm leading-8 text-[#927783]">برای دیدن عکس‌ها، مدل‌های تازه و خبرهای نانا، پیج <a class="font-bold text-[#b65e80]" href="https://www.instagram.com/nana.accessoryy/" target="_blank" rel="noopener noreferrer">@nana.accessoryy</a> رو دنبال کن.</p></details>
    </div></div></section>
    <section class="container pb-20"><div class="rounded-[2.5rem] bg-gradient-to-l from-[#71465a] to-[#a96883] px-6 py-14 text-center text-white md:px-12"><div class="text-4xl">♡ ✿ ୨୧</div><h2 class="mt-5 text-3xl font-black">بیا چیز قشنگت رو پیدا کنیم!</h2><p class="mt-4 text-sm leading-8 text-white/80">مدل‌ها رو ببین، سوالت رو بپرس یا فقط بیا سلام کن. همیشه جا برای یه کوچولو خوشگلی هست.</p><div class="mt-7 flex flex-wrap justify-center gap-3"><a href="https://basalam.com/nana-accessory" target="_blank" rel="noopener noreferrer" class="rounded-full bg-white px-6 py-3 text-sm font-black text-[#71465a]">خرید از باسلام ↗</a><a href="https://www.instagram.com/nana.accessoryy/" target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/50 px-6 py-3 text-sm font-bold text-white">اینستاگرام نانا ↗</a></div></div></section>
  </main>
  <footer class="border-t border-rose-100 bg-white py-8"><div class="container flex flex-col items-center justify-between gap-4 text-center text-xs text-[#a27b89] sm:flex-row"><a href="/" class="font-black text-[#70495a]">♡ نانا اکسسوری شاپ</a><span>با یه کوچولو عشق ساخته شده ♡ © {new Date().getFullYear()} نانا</span><a href="https://www.instagram.com/nana.accessoryy/" target="_blank" rel="noopener noreferrer">اینستاگرام ↗</a></div></footer>
</BaseLayout>
